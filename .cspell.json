{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": [
    "${env:GERMAN_DICT_PATH}/cspell-ext.json"
  ],
  "ignorePaths": [
    ".cspell.json",
    ".git",
    ".vscode/extensions.json",
    ".vscode/settings.json",
    "assets/case/",
    "assets/circuit/diagram-*.svg"
  ],
  "language": "en",
  "languageSettings": [],
  "overrides": [
    {
      "filename": [
        "**/*.html",
        "**/*.js"
      ],
      "language": "en,de",
      "words": [
        "ethernet",
        "hardwarebedingt",
        "hotspot",
        "ssid",
        "wifi"
      ]
    },
    {
      "filename": "**/*.svg",
      "words": [
        "evenodd"
      ]
    }
  ],
  "cache": {
    "useCache": true,
    "cacheStrategy": "content"
  },
  "failFast": true,
  "enableGlobDot": true,
  "useGitignore": true,
