{
  "name": "dmx-interface (Nix)",
  // Plain Ubuntu base + the official Nix feature; all tooling still comes
  // from flake.nix via `nix develop` (see AGENTS.md → "Dev shell").
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      // Enables `nix` and `nix develop` for lifecycle commands and terminals.
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  // Root, deliberately: a non-root user can never own the bind-mounted
  // workspace on the supported engines (Windows drvfs forces uid=1000, which
  // rootless Podman maps to container uid 0; Docker Desktop mounts as root),
  // so npm/vite/git all fail for `vscode` — see AGENTS.md → "Dev container".
  // Root is the owner on every engine, and the Dev Containers tooling skips
  // its --userns=keep-id injection for root (which suits us: Docker rejects
  // that flag, so it could not ship in an engine-neutral config anyway).
  "remoteUser": "root",
  // Share the host's device nodes so `inv flash` sees the ESP32 as
  // /dev/ttyACM0 (hot-plug works; no --device, that breaks creation on
  // hosts without the board attached, e.g. Windows without usbipd).
  // Mounted at /host-dev instead of /dev: a direct /dev bind would replace
  // the container's devpts with the host's, and pty exec as a non-root user
  // then fails on rootless engines (crun: chown /dev/pts/N: EPERM).
  // ensure-tty.sh symlinks the usual paths (/dev/ttyACM0, /dev/serial).
  "mounts": ["source=/dev,target=/host-dev,type=bind"],
  // Engine notes: `remoteUser: root` keeps this config engine-neutral — no
  // --userns=keep-id (Docker rejects it) and no engine-specific runArgs are
  // needed for workspace ownership. Hosts where docker is Podman in disguise
  // — NixOS symlink, or Podman without a docker shim — still need the VS Code
  // user setting "dev.containers.dockerPath": "podman" so the tooling finds
  // the right CLI — see README → Development container. Serial-device group
  // access on rootless Podman is a host-side containers.conf concern,
  // likewise documented in the README.
  //
  // The CDC device can enumerate after container start (hot-plug). Lifecycle
  // commands run from the workspace folder (per spec), so the script path is
  // relative — robust against any client cwd and paths with spaces — and it
  // is backgrounded so postStart exits immediately.
  "postStartCommand": "nohup bash .devcontainer/ensure-tty.sh >/tmp/ensure-tty.log 2>&1 &",
  // Docker Desktop (Windows) denies open() on character devices the
  // container mknods itself (device cgroup: EPERM on /dev/ttyACM0), so
  // flashing needs --privileged. Ships on purpose as a default for every
  // engine — full caps/devices on rootful Docker is a conscious trade-off
  // for a firmware devcontainer, rootless Podman tolerates the flag
  // (README → Development container → Flashing).
  "runArgs": ["--privileged"],
  // Warm the flake: `nix develop` itself builds/downloads the whole dev
  // shell (Xtensa toolchain), the command inside is irrelevant — plain
  // `true`, so a broken tasks.py can never fail container creation.
  // Preceded by a system-wide git safe.directory wildcard: we run as root on
  // engines where the workspace is *not* root-owned (rootful Linux Podman,
  // Docker on Linux), and git's "dubious ownership" check would otherwise
  // refuse the repo inside the container. Running as root on the ownership
  // cases the wildcard covers is exactly the identity libgit2 accepts, so no
  // chown is needed or wanted — re-owning host files was the old vscode-user
  // workaround (see AGENTS.md → "Dev container").
  "postCreateCommand": "git config --system --add safe.directory '*' || true; nix develop --command true",
  // Block until the warm finished; the spec default only waits for
  // updateContentCommand, which would let terminals run before the toolchain
  // exists.
  "waitFor": "postCreateCommand",
  // Vite dev server (`inv web:dev`).
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "oxc.oxc-vscode",
        "streetsidesoftware.code-spell-checker",
        "davidanson.vscode-markdownlint",
        // Not pinage404.nix-extension-pack (as .vscode/extensions.json recommends
        // for native setups): it also ships nix-env-selector, whose terminal
        // patching ("open new user terminals inside nix-shell", default on)
        // rewraps the nix-shell profile below and dies with exit 1, and
        // mkhl.direnv, which needs a direnv binary the extension host does not
        // have (direnv only exists inside `nix develop`). Both are redundant
        // in the container — the terminal profile, ra-nix.sh and the task
        // wrappers own the environment — so we keep only the Nix formatter.
        "jnoortheen.nix-ide",
        "yoavbls.pretty-ts-errors",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        // The extension host does not enter `nix develop` on its own; re-exec
        // rust-analyzer through the flake so cargo & co. are on PATH.
        "rust-analyzer.server.path":
          "${containerWorkspaceFolder}/.devcontainer/ra-nix.sh",
        "terminal.integrated.defaultProfile.linux": "nix-shell",
        "terminal.integrated.profiles.linux": {
          "nix-shell": {
            "path": "nix",
            "args": ["develop"]
          }
        }
      }
    }
  }
}
