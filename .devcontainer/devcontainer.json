{
  "name": "dmx-interface (Nix)",
  // Plain Ubuntu base + the official Nix feature; all tooling still comes
  // from flake.nix via `nix develop` (see AGENTS.md -> "Dev shell").
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  // Root, deliberately: the bind-mounted workspace is owned by container
  // uid 0 on every supported engine, so a non-root user could never write
  // it - see WINDOWS.md -> "How it works". The Dev Containers tooling also
  // skips its --userns=keep-id injection for root (Docker rejects the flag).
  "remoteUser": "root",
  // Share the machine's device nodes: the bind at /host-dev exposes the
  // live /dev of the podman machine, so `inv flash` talks to the ESP32
  // through /host-dev/ttyACM0 (tasks.py prefers it; /dev/ttyACM* inside
  // the container are Podman's per-start binds and go stale on every
  // hotplug re-enumeration). /host-dev instead of /dev: a direct bind
  // would replace the container's devpts and break pty exec on rootless
  // engines. Node readability comes from the machine-side udev rule
  // (scripts/machine-udev.sh).
  "mounts": ["source=/dev,target=/host-dev,type=bind"],
  // Docker denies open() on character devices the container mknods itself
  // (device cgroup: EPERM), so flashing needs --privileged; shipped for
  // every engine on purpose (rootless Podman tolerates the flag).
  "runArgs": ["--privileged"],
  // Warm the flake: `nix develop` downloads the whole dev shell (Xtensa
  // toolchain); the command inside is irrelevant. The git safe.directory
  // wildcard is configured at image build time (Dockerfile).
  "postCreateCommand": ["nix develop --command true"],
  // Block until the warm finished - the spec default only waits for
  // updateContentCommand.
  "waitFor": "postCreateCommand",
  // Vite dev server (`inv web:dev`).
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "oxc.oxc-vscode",
        "streetsidesoftware.code-spell-checker",
        "davidanson.vscode-markdownlint",
        // Not pinage404.nix-extension-pack (.vscode/extensions.json's native
        // recommendation): nix-env-selector's terminal patching and
        // mkhl.direnv's missing direnv binary break the container setup.
        "jnoortheen.nix-ide",
        "yoavbls.pretty-ts-errors",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        // The extension host does not enter `nix develop`; re-exec
        // rust-analyzer through the flake so cargo & co. are on PATH.
        "rust-analyzer.server.path":
          "${containerWorkspaceFolder}/.devcontainer/ra-nix.sh",
        "terminal.integrated.defaultProfile.linux": "nix-shell",
        "terminal.integrated.profiles.linux": {
          "nix-shell": {
            "path": "nix",
            "args": ["develop"]
          }
        }
      }
    }
  }
}
